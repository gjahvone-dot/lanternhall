# ---- AI keys: set at least one ----
ANTHROPIC_API_KEY=        # Claude, from platform.claude.com
OPENAI_API_KEY=           # GPT, from platform.openai.com
GEMINI_API_KEY=           # Gemini, from aistudio.google.com

# ---- Which AI runs each seat on the council: anthropic, openai or gemini ----
GM_AI=anthropic           # the Game Master (narration)
CHRONICLER_AI=anthropic   # memory, quests, relationships
VOICES_AI=anthropic       # characters talking back
FORGE_AI=anthropic        # classes and backstories

# ---- Models (Claude has defaults; GPT and Gemini need a model name if you use them) ----
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_FAST_MODEL=claude-haiku-5-5
OPENAI_MODEL=             # copy a current model name from platform.openai.com/docs/models
OPENAI_FAST_MODEL=        # optional, a cheaper model for quick jobs
GEMINI_MODEL=             # copy a current model name from ai.google.dev/gemini-api/docs/models
GEMINI_FAST_MODEL=        # optional

# ---- Multiplayer tables (free Supabase project) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Protect your AI bill ----
ACCESS_CODE=              # optional password players must enter before the AI answers
RATE_LIMIT=80             # AI requests allowed per visitor every 10 minutes
